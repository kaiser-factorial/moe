import torch\
from collections import defaultdict\
\
# storage: layer_idx -> list of (topk_indices, topk_weights) per forward call\
routing_log = defaultdict(list)\
\
def make_router_hook(layer_idx):\
    def hook(module, inputs, outputs):\
        topk_indices, topk_weights = outputs\
        # detach + cpu so we don't hold gpu memory\
        routing_log[layer_idx].append(\{\
            "indices": topk_indices.detach().cpu(),   # (N_tokens, 6)\
            "weights": topk_weights.detach().cpu(),   # (N_tokens, 6)\
        \})\
    return hook\
\
# register hooks on every MoE layer's gate\
hooks = []\
for layer_idx, block in enumerate(model.backbone.layers):\
    if block.block_type == "moe":\
        h = block.mixer.gate.register_forward_hook(make_router_hook(layer_idx))\
        hooks.append(h)\
\
