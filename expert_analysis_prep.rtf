# aggregate across all 20 MoE layers and all generated tokens\
# result: (20, 128) = how often each expert was in the top-6 for each layer\
import numpy as np\
\
def utilization_matrix(routing_log, n_layers=20, n_experts=128):\
    # routing_log[layer_idx] -> list of \{indices: (N, 6), weights: (N, 6)\}\
    util = np.zeros((n_layers, n_experts))\
    moe_layer_ids = sorted(routing_log.keys())  # actual layer idxs in the full 52\
    for local_i, global_i in enumerate(moe_layer_ids):\
        for step in routing_log[global_i]:\
            idx = step["indices"].numpy().flatten()  # all expert choices\
            for e in idx:\
                util[local_i, e] += 1\
    return util, moe_layer_ids\
\
# weighted version: weight by the router's normalized weight, not just "was it picked"\
def weighted_utilization(routing_log, n_layers=20, n_experts=128):\
    util = np.zeros((n_layers, n_experts))\
    moe_layer_ids = sorted(routing_log.keys())\
    for local_i, global_i in enumerate(moe_layer_ids):\
        for step in routing_log[global_i]:\
            idx = step["indices"].numpy()    # (N, 6)\
            w = step["weights"].numpy()      # (N, 6)\
            for token_i in range(idx.shape[0]):\
                for k in range(idx.shape[1]):\
                    util[local_i, idx[token_i, k]] += w[token_i, k]\
    return util, moe_layer_ids}